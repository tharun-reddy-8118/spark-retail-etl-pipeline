# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Logs and Crash Dumps
*.log
logs/*
!logs/.gitkeep
hs_err_pid*.log
replay_pid*.log

# Runtime data and output folders (prevent staging huge CSV/Parquet files)
data/raw/*
data/processed/*
data/staging/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/staging/.gitkeep
output/*
!output/.gitkeep
warehouse/*
!warehouse/.gitkeep

# Virtual environments
venv/
.venv/
env/
.env

# IDEs and Editors
.idea/
.vscode/
*.code-workspace

# System Files
.DS_Store
Thumbs.db

# Agent / AI local directories
.gemini/
brain/
.antigravityignore
